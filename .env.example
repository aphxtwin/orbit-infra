# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=provisioning
DB_SSLMODE=disable

# Database Connection Pool Settings
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME_MINUTES=30
DB_MAX_CONN_IDLE_TIME_MINUTES=5

# AWS Configuration
# Region where your Lambda functions are deployed
AWS_REGION=us-east-1

# AWS Credentials (required for Lambda invocation)
# Get these from IAM user or use temporary credentials
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Optional: Session token for temporary credentials
# AWS_SESSION_TOKEN=your_session_token_here

# KMS Configuration (optional for dev, required for production)
# ARN of the KMS key used for encrypting tenant data
KMS_KEY_ARN=

# Lambda Function Names
# Name of the Lambda function that provisions tenants
AWS_PROVISIONING_LAMBDA_NAME=tenant-provisioning

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=debug
PORT=8080
